{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ratingsdb:contract:chart-search:v1",
  "title": "GraphTV search response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": { "type": "array", "items": { "$ref": "#/$defs/card" } },
    "degradation": { "type": "array", "items": { "$ref": "#/$defs/degradation" } }
  },
  "$defs": {
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "year", "poster", "genres", "externalIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "year": { "type": "string", "pattern": "^$|^[0-9]{4}$" },
        "poster": { "type": ["string", "null"] },
        "genres": { "type": "array", "items": { "type": "string" } },
        "externalIds": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "degradation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "capability", "reason"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "capability": { "enum": ["search", "hydration"] },
        "reason": { "enum": ["unconfigured", "unavailable", "partial", "budget_exhausted"] }
      }
    }
  }
}
