{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ratingsdb:contract:chart-bundle:v1",
  "title": "GraphTV chart bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contentVersion", "generatedAt", "scoringProfile", "show", "seasons", "providers", "incomplete", "stats"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contentVersion": { "$ref": "#/$defs/contentVersion" },
    "generatedAt": { "$ref": "#/$defs/timestamp" },
    "scoringProfile": { "type": "string", "minLength": 1 },
    "show": { "$ref": "#/$defs/show" },
    "seasons": { "type": "array", "items": { "$ref": "#/$defs/season" } },
    "providers": { "type": "array", "items": { "$ref": "#/$defs/providerStatus" } },
    "incomplete": { "type": "boolean" },
    "stats": { "$ref": "#/$defs/stats" }
  },
  "$defs": {
    "contentVersion": {
      "type": "string",
      "pattern": "^$|^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "source": {
      "type": "string",
      "anyOf": [
        { "enum": ["imdb", "tvmaze", "tmdb", "trakt", "rtCritics", "rtAudience", "mcCritics", "mcAudience", "combined"] },
        { "pattern": "^[a-z0-9_]+$" }
      ]
    },
    "rating10": {
      "type": "number",
      "minimum": 0,
      "maximum": 10
    },
    "rating": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "rating", "votes"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "rating": { "oneOf": [{ "$ref": "#/$defs/rating10" }, { "type": "null" }] },
        "votes": { "type": ["integer", "null"], "minimum": 0 },
        "metric": { "enum": ["averageScore", "percentagePositive"] },
        "contributors": { "type": "array", "items": { "$ref": "#/$defs/source" }, "uniqueItems": true },
        "alignment": { "$ref": "#/$defs/alignment" }
      }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "confidence"],
      "properties": {
        "strategy": { "enum": ["external-id", "title-date", "title", "part-title-date", "part-title", "base-title-date"] },
        "confidence": { "enum": ["strong"] },
        "evidence": { "$ref": "#/$defs/alignmentEvidence" }
      }
    },
    "alignmentEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "part", "date"],
      "properties": {
        "title": { "type": "string" },
        "part": { "type": "string" },
        "date": { "type": "string" }
      }
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "show": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "year", "endYear", "plot", "poster", "totalSeasons", "genres", "ratings", "externalIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "year": { "type": "string", "pattern": "^$|^[0-9]{4}$" },
        "endYear": { "type": ["integer", "null"] },
        "plot": { "type": ["string", "null"] },
        "poster": { "type": ["string", "null"] },
        "totalSeasons": { "type": "integer", "minimum": 0 },
        "genres": { "type": "array", "items": { "type": "string" } },
        "ratings": { "type": "array", "items": { "$ref": "#/$defs/rating" } },
        "externalIds": { "$ref": "#/$defs/stringMap" }
      }
    },
    "season": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "title", "episodes"],
      "properties": {
        "number": { "type": "integer", "minimum": 0 },
        "title": { "type": ["string", "null"] },
        "episodes": { "type": "array", "items": { "$ref": "#/$defs/episode" } }
      }
    },
    "episode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "plot", "season", "episode", "date", "poster", "ratings", "sourceIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "plot": { "type": ["string", "null"] },
        "season": { "type": "integer", "minimum": 0 },
        "episode": { "type": "integer", "minimum": 1 },
        "date": { "type": ["string", "null"] },
        "poster": { "type": ["string", "null"] },
        "ratings": { "type": "array", "items": { "$ref": "#/$defs/rating" } },
        "sourceIds": { "$ref": "#/$defs/stringMap" }
      }
    },
    "providerStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "status", "contributed"],
      "properties": {
        "source": { "$ref": "#/$defs/source" },
        "status": { "enum": ["fresh", "stale", "pending", "failed", "disabled", "computed", "redacted"] },
        "contributed": { "type": "boolean" },
        "lastSuccessAt": { "$ref": "#/$defs/timestamp" },
        "expiresAt": { "$ref": "#/$defs/timestamp" },
        "reason": { "type": "string" }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["episodes", "omittedUnnumbered", "rated"],
      "properties": {
        "episodes": { "type": "integer", "minimum": 0 },
        "omittedUnnumbered": { "type": "integer", "minimum": 0 },
        "rated": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
      }
    }
  }
}
