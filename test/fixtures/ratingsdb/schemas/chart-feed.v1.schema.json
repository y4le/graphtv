{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ratingsdb:contract:chart-feed:v1",
  "title": "GraphTV chart feed v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "feed", "contentVersion", "generatedAt", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "feed": { "enum": ["popular", "trending-day", "trending-week"] },
    "contentVersion": { "type": "string", "pattern": "^$|^sha256:[0-9a-f]{64}$" },
    "generatedAt": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rank", "show"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "show": { "$ref": "#/$defs/card" }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "year", "poster", "genres", "externalIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "year": { "type": "string", "pattern": "^$|^[0-9]{4}$" },
        "poster": { "type": ["string", "null"] },
        "genres": { "type": "array", "items": { "type": "string" } },
        "externalIds": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
