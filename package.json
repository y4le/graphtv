{
  "name": "graphtv",
  "version": "1.0.0",
  "description": "graphtv rewrite with bundled dependencies, provider-aware data, and a D3 visualization system.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare:client-secrets": "node scripts/generate-client-secrets.mjs",
    "predev": "npm run prepare:client-secrets",
    "dev": "vite",
    "dev:tailnet": "bash scripts/dev.sh",
    "prebuild": "npm run prepare:client-secrets",
    "build": "vite build",
    "preview": "vite preview",
    "pretest": "npm run prepare:client-secrets",
    "test": "vitest run",
    "test:watch": "vitest",
    "prelint": "npm run prepare:client-secrets",
    "lint": "eslint src test scripts eslint.config.js vite.config.js",
    "format": "prettier --write .",
    "size": "node scripts/report-bundle-size.mjs"
  },
  "keywords": [
    "tv",
    "ratings",
    "visualization"
  ],
  "license": "ISC",
  "dependencies": {
    "d3": "^7.9.0",
    "jsdom": "^26.1.0"
  },
  "devDependencies": {
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
